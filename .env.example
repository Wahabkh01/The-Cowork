# Google Sheets Web App URL (obtain this after deploying your Google Apps Script)
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# Trustindex Google-reviews widget ID (homepage reviews carousel).
# Get it from https://admin.trustindex.io -> your widget -> "Get the code":
# the embed looks like <script src="https://cdn.trustindex.io/loader.js?abc123def">
# and the part after the "?" is the ID. Leave unset to fall back to the
# prerendered carousel built from src/data/reviews.ts.
VITE_TRUSTINDEX_WIDGET_ID=
